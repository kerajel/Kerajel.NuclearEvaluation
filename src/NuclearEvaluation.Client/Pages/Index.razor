@page "/"
@implements IDisposable
@inject HttpClient Http
@inject ILogger<Index> Logger

<PageTitle>Nuclear Evaluation | Radiation data workbench</PageTitle>

<div class="radiation-home">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero-copy">
            <div class="home-source">
                <RadzenIcon Icon="sensors" aria-hidden="true" />
                EPA RadNet archive
            </div>
            <h1 id="home-title">Radiation data workbench</h1>
            <p>Build and review Series from published EPA measurements. Add Series to a project and follow its coverage from the chart down to the original observations.</p>
            <div class="home-actions">
                <a class="home-primary" href="workbench">Open Series <RadzenIcon Icon="arrow_forward" aria-hidden="true" /></a>
                <a class="home-secondary" href="workbench?view=projects">Explore Projects</a>
            </div>
        </div>
        <figure class="home-station">
            <img src="images/radnet-montgomery-epa-oig.jpg" width="410" height="547"
                 alt="Stationary RadNet monitoring cabinet and sensor mast" fetchpriority="high" />
            <figcaption>
                <span>RadNet monitor</span>
                Montgomery, Alabama · EPA OIG
            </figcaption>
        </figure>
    </section>

    <section class="home-archive" aria-label="Archive coverage" aria-busy="@(_summaryLoaded ? "false" : "true")">
        @if (_summary is { Available: true } summary)
        {
            <dl class="home-metrics">
                <div><dt>Observations</dt><dd>@summary.ObservationCount.ToString("N0")</dd></div>
                <div><dt>Monitoring stations</dt><dd>@summary.StationCount.ToString("N0")</dd></div>
                <div><dt>Annual source files</dt><dd>@summary.SourceFileCount.ToString("N0")</dd></div>
                <div><dt>Coverage</dt><dd>@FormatCoverage(summary.Coverage)</dd></div>
            </dl>
        }
        else
        {
            <p class="home-archive-status" role="status">
                @(_summaryLoaded ? "Archive snapshot unavailable on this host." : "Loading archive coverage…")
            </p>
        }
    </section>

    <section class="home-tools" aria-labelledby="home-tools-title">
        <h2 id="home-tools-title">Analyze the archive</h2>
        <div class="home-tool-grid">
            <a class="home-tool" href="workbench?view=builder">
                <div class="home-tool-icon"><RadzenIcon Icon="tune" aria-hidden="true" /></div>
                <div>
                    <h3>Query Builder</h3>
                    <p>Filter Projects, Series, files, observations, and gamma channels in one query. Run the California coverage preset to see how the levels work together.</p>
                </div>
                <RadzenIcon Icon="arrow_forward" class="home-tool-arrow" aria-hidden="true" />
            </a>
            <a class="home-tool" href="radiation?view=quality">
                <div class="home-tool-icon"><RadzenIcon Icon="fact_check" aria-hidden="true" /></div>
                <div>
                    <h3>File quality</h3>
                    <p>Inspect a station file’s date range, reporting gaps, and channel coverage. Follow its link to the original archive.</p>
                </div>
                <RadzenIcon Icon="arrow_forward" class="home-tool-arrow" aria-hidden="true" />
            </a>
        </div>
    </section>

    <section class="home-context" aria-label="Related workspaces">
        <div>
            <h2>Radiochemistry</h2>
            <p>Trace radionuclide measurements in air, water, food, and other media to their sampling locations and published files in the European Commission’s REMdb archive.</p>
            <div class="home-context-links">
                <a href="radiochemistry">Browse measurements</a>
                <a href="radiochemistry?view=builder">Build a query</a>
                <a href="radiochemistry?view=quality">Inspect source files</a>
            </div>
        </div>
        <div>
            <h2>Nuclear power</h2>
            <p>Explore reported plant capacity and generation, then compare lifecycle emissions.</p>
            <div class="home-context-links">
                <a href="fleet">Fleet Explorer</a>
                <a href="fleet-generation">Generation Calendar</a>
                <a href="energy-emissions">Energy &amp; Emissions</a>
            </div>
        </div>
    </section>
</div>

@code {
    readonly CancellationTokenSource _lifetime = new();
    RadNetSummary? _summary;
    bool _summaryLoaded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Http.GetFromJsonAsync<RadNetSummary>("api/radnet/summary", _lifetime.Token);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        {
            Logger.LogDebug(exception, "Unable to load the RadNet archive summary.");
        }
        finally
        {
            _summaryLoaded = true;
        }
    }

    static string FormatCoverage(IReadOnlyList<RadNetYearCoverage> coverage)
    {
        if (coverage.Count == 0)
            return "—";

        int first = coverage.Min(item => item.Year);
        int last = coverage.Max(item => item.Year);
        return first == last ? first.ToString() : $"{first}–{last}";
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
