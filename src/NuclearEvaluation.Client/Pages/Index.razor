@page "/"
@using NuclearEvaluation.Client.Shared.Fleet
@inject HttpClient Http

<PageTitle>Nuclear Evaluation</PageTitle>

<section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-copy">
        <h1 id="home-title">Nuclear Evaluation</h1>
        <p>Explore the U.S. nuclear fleet. See where plants are, how much power they can supply, and how much electricity they generate.</p>
        <a class="home-primary" href="fleet">Explore the fleet <span aria-hidden="true">→</span></a>
    </div>
    <div class="home-hero-map" aria-hidden="true">
        <FleetMap Plants="@(_fleet?.Plants ?? [])" />
    </div>
</section>

<div class="home-destinations">
    <a class="home-destination" href="energy-emissions">
        <RadzenIcon Icon="bar_chart" />
        <div>
            <h2>Energy &amp; Emissions</h2>
            <p>Compare lifecycle greenhouse gas estimates across six electricity sources.</p>
        </div>
        <span class="home-arrow" aria-hidden="true">→</span>
    </a>
    <a class="home-destination" href="data-management?tab=stem-preview&amp;view=quality">
        <RadzenIcon Icon="fact_check" />
        <div>
            <h2>STEM Quality</h2>
            <p>Inspect a spreadsheet for missing measurements and repeated identifiers, then open the affected rows.</p>
        </div>
        <span class="home-arrow" aria-hidden="true">→</span>
    </a>
</div>

<section class="home-workspace" aria-labelledby="home-workspace-title">
    <h2 id="home-workspace-title">Evaluation workspace</h2>
    <p>The shared sandbox uses generated example data. Changes reset periodically and file uploads are temporary.</p>
    <div class="home-workspace-links">
        <a href="data-management">Browse series and samples</a>
        <a href="evaluation">Explore projects and build queries</a>
    </div>
</section>

@code {
    private FleetSnapshot? _fleet;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _fleet = await Http.GetFromJsonAsync<FleetSnapshot>(FleetSnapshot.AssetPath);
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        {
            // The map on the home page is a preview. Keep its link and the workspace available.
        }
    }
}
