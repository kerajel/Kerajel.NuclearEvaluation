@using NuclearEvaluation.Client.Shared.Charts
@using NuclearEvaluation.Client.Shared.Evaluation.Project

<PageTitle>@(_projectView?.Name ?? "Project") | Nuclear Evaluation</PageTitle>

@if (_isLoading)
{
    <GridLoadingPlaceholder Label="Loading project…" />
}
else if (_loadError is not null)
{
    <section class="project-state">
        <p role="alert">@_loadError</p>
        <div class="project-actions">
            <RadzenButton Text="Try again" Click="LoadCurrentProject" />
            <RadzenButton Text="Back to Projects" Icon="arrow_back" Variant="Variant.Text" Click="@GoBack" />
        </div>
    </section>
}
else if (_projectView is not null)
{
    <article class="project-workspace" aria-label="Project details">
        <header class="project-header">
            <RadzenButton Text="Back to Projects" Icon="arrow_back" Variant="Variant.Text" Click="@GoBack" />
            <div class="project-title">
                @if (!_isEditingProjectName)
                {
                    <h1 id="projectNameHeading">@_projectView.Name</h1>
                }
                else
                {
                    <div>
                        <label class="project-name-label" for="projectNameInput">Project name</label>
                        <ValidatedTextBox Id="projectNameInput"
                                      TModel="ProjectView"
                                      @ref="_projectNameInputRef"
                                      Model="@_projectView"
                                      PropertyExpression="@(x => x.Name)"
                                      Validator="ProjectViewValidator"
                                      AutoCompleteType="AutoCompleteType.Off"
                                      Style="width: 100%; font-size: 1.35rem;"
                                      TooltipOffsetX="5"
                                      TooltipOffsetY="38"
                                      OnValidationStateChanged="@OnProjectNameValidationStateChanged" />
                    </div>
                }
                <div class="project-actions">
                    @if (!_isEditingProjectName)
                    {
                        <RadzenButton id="editProjectNameButton" Icon="edit" Variant="Variant.Outlined"
                                      aria-label="Edit project name" title="Edit project name" Click="@EditProjectName" />
                    }
                    else
                    {
                        <RadzenButton id="saveProjectNameButton" Icon="check" aria-label="Save project name"
                                      title="Save project name" Click="@SaveProjectNameChanges" Disabled="@(!CanSaveProjectName())" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                                      aria-label="Cancel renaming" title="Cancel renaming" Click="@CancelEditProjectName" />
                    }
                </div>
            </div>
        </header>

        <div class="project-settings">
            <section class="project-settings__group" aria-labelledby="project-series-label">
                <div>
                    <h2 id="project-series-label">Series membership</h2>
                    <p class="project-series-ids">@(string.IsNullOrWhiteSpace(_projectView.SeriesIds) ? "No series assigned" : _projectView.SeriesIds)</p>
                </div>
                <div class="project-actions">
                    @if (!_isEditingSeries)
                    {
                        <RadzenButton Icon="edit" Variant="Variant.Outlined"
                                      aria-label="Edit series membership" title="Edit series membership" Click="@EditSeries" />
                    }
                    else
                    {
                        <RadzenButton Icon="check" aria-label="Save series changes" title="Save series changes"
                                      Click="@SaveSeriesChanges" Disabled="@(!CanSaveProjectSeries())" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                                      aria-label="Cancel series editing" title="Cancel series editing" Click="@CancelEditSeries" />
                    }
                </div>
            </section>
            <div class="project-settings__date">
                <RadzenLabel Text="Decay correction date" Component="projectDecayCorrectionDate" />
                <RadzenDatePicker @bind-Value="@_decayCorrectionDateInput"
                                  Name="projectDecayCorrectionDate"
                                  Change="@OnDecayCorrectionDateChange"
                                  DateFormat="yyyy-MM-dd"
                                  NavigationMode="DatePickerNavigationMode.DropDown"
                                  ShowTime="false" />
            </div>
        </div>

        @if (_isEditingSeries)
        {
            <section class="project-series-editor" aria-label="Edit series membership">
                @if (!string.IsNullOrWhiteSpace(_seriesUpdateError))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="false" Variant="Variant.Flat" Shade="Shade.Lighter">
                        @_seriesUpdateError
                    </RadzenAlert>
                }
                <SeriesGrid @ref="_seriesGridRef"
                            Visible="_isEditingSeries"
                            ComponentId="fb7e7455-b562-4852-892c-2b8e51197fa6"
                            Caption="Select the series to include, then save series changes."
                            SelectedEntryIds="_selectedSeriesIds"
                            OnEntriesSelected="OnSeriesSelectionChange"
                            OnEntriesDeselected="OnSeriesSelectionChange"
                            AllowEdit="false"
                            AllowExpand="false"
                            AllowSelect="true" />
            </section>
        }

        <div class="project-tabs" tabindex="-1" aria-label="Project records" role="region" @ref="_projectTabs">
            <RadzenTabs RenderMode="@TabRenderMode" @bind-SelectedIndex="tabManager.SelectedTabIndex" Change="OnTabChanged" Overflow="TabsOverflow.Wrap">
                <Tabs>
                    <RadzenTabsItem Text="Overview">
                        <section class="project-records" aria-labelledby="project-records-title">
                            <h2 id="project-records-title">Explore related records</h2>
                            <ol class="project-records__path">
                                <li>
                                    <button type="button" @onclick="() => OpenRelatedRecords(SeriesTabIndex)">
                                        <span>Linked series</span>
                                        <strong>@_projectView.ProjectSeries.Count.ToString("N0")</strong>
                                    </button>
                                </li>
                                <li>
                                    <button type="button" @onclick="() => OpenRelatedRecords(SamplesTabIndex)">
                                        <span>Samples</span>
                                        <strong>@_projectView.SampleCount.ToString("N0")</strong>
                                    </button>
                                </li>
                                <li>
                                    <button type="button" @onclick="() => OpenRelatedRecords(SubSamplesTabIndex)">
                                        Subsamples
                                    </button>
                                </li>
                                <li>
                                    <div class="project-records__measurements" role="group" aria-label="Measurements">
                                        <button type="button" @onclick="() => OpenRelatedRecords(ApmTabIndex)">APM measurements</button>
                                        <button type="button" @onclick="() => OpenRelatedRecords(ParticleTabIndex)">Particle measurements</button>
                                    </div>
                                </li>
                            </ol>
                        </section>
                        <ProjectOverview ProjectView="@_projectView" />
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Series">
                        <SeriesGrid @ref="projectSeriesGrid"
                                    ComponentId="bea40ae9-0cce-41c1-bdeb-71451d85451c"
                                    Caption="Series assigned to this project."
                                    AllowEdit="false"
                                    ReserveHeight="false"
                                    ProjectId="@_projectView.Id" />
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Samples">
                        <SampleGrid @ref="sampleGrid"
                                    ComponentId="e6c4e44f-3994-489d-a890-f7b4f46b4fc1"
                                    Caption="Samples linked through this project's assigned series."
                                    ReserveHeight="false"
                                    ProjectId="@_projectView.Id" />
                    </RadzenTabsItem>


                    <RadzenTabsItem Text="SubSamples">
                        <SubSampleGrid @ref="subSampleGrid"
                                       ComponentId="3d8e07c1-6f46-4a6e-818c-9ef3be34090a"
                                       Caption="Subsamples linked through this project's samples."
                                       ReserveHeight="false"
                                       ProjectId="@_projectView.Id" />
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Apm">
                        @{ MeasurementGridScope apmScope = _apmGridScope; }
                        @if (tabManager.SelectedTabIndex == ApmTabIndex)
                        {
                            <a class="project-distribution-link" href="@DistributionHref(ApmTabName, ApmDistributionId)"
                               @onclick:preventDefault @onclick="() => _apmDistribution.FocusAsync().AsTask()">
                                View isotope distribution <span aria-hidden="true">↓</span>
                            </a>
                        }
                        <ApmGrid @key="apmScope" @ref="apmGrid"
                                 ComponentId="6e6ed866-a4e3-4b41-9eaf-e63dd2415fcf"
                                 Caption="APM measurements for this project. Grid filters define the result set used by the chart below."
                                 EnableDecayCorrection="@( _projectView.DecayCorrectionDate.HasValue)"
                                 ProjectId="@_projectView.Id"
                                 ReserveHeight="false"
                                 OnLoadStarted="@(() => OnMeasurementLoadStarted(apmScope))"
                                 OnQueryChanged="@(query => OnMeasurementQueryChanged(apmScope, query))" />

                        @if (tabManager.SelectedTabIndex == ApmTabIndex)
                        {
                            <div id="@ApmDistributionId" class="project-distribution-target" tabindex="-1"
                                 role="region" aria-label="APM isotope distribution" @ref="_apmDistribution">
                                <ProjectApmUraniumBinCountsChart @ref="apmBinChart"
                                                                  ProjectId="@Id"
                                                                  Query="@_apmChartQuery"
                                                                  QueryVersion="@_apmChartQueryVersion"
                                                                  AwaitingGridQuery="@(!_apmGridLoaded)"
                                                                  Caption="Follows the APM grid’s filters and decay correction." />
                            </div>
                        }
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Particles">
                        @{ MeasurementGridScope particleScope = _particleGridScope; }
                        @if (tabManager.SelectedTabIndex == ParticleTabIndex)
                        {
                            <a class="project-distribution-link" href="@DistributionHref(ParticleTabName, ParticleDistributionId)"
                               @onclick:preventDefault @onclick="() => _particleDistribution.FocusAsync().AsTask()">
                                View isotope distribution <span aria-hidden="true">↓</span>
                            </a>
                        }
                        <ParticleGrid @key="particleScope" @ref="particleGrid"
                                      ComponentId="05dbb724-079b-4a39-9cf8-1318c29091ac"
                                      Caption="Particle measurements for this project. Grid filters define the result set used by the chart below."
                                      EnableDecayCorrection="@( _projectView.DecayCorrectionDate.HasValue)"
                                      ProjectId="@_projectView.Id"
                                      ReserveHeight="false"
                                      OnLoadStarted="@(() => OnMeasurementLoadStarted(particleScope))"
                                      OnQueryChanged="@(query => OnMeasurementQueryChanged(particleScope, query))" />

                        @if (tabManager.SelectedTabIndex == ParticleTabIndex)
                        {
                            <div id="@ParticleDistributionId" class="project-distribution-target" tabindex="-1"
                                 role="region" aria-label="Particle isotope distribution" @ref="_particleDistribution">
                                <ProjectParticleUraniumBinCountsChart @ref="particleBinChart"
                                                                       ProjectId="@Id"
                                                                       Query="@_particleChartQuery"
                                                                       QueryVersion="@_particleChartQueryVersion"
                                                                       AwaitingGridQuery="@(!_particleGridLoaded)"
                                                                       Caption="Follows the Particles grid’s filters and decay correction." />
                            </div>
                        }
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </div>
    </article>
}
