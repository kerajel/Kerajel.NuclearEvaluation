@page "/workbench"
@using NuclearEvaluation.Client.Shared.Workbench

<PageTitle>Data Workbench · Nuclear Evaluation</PageTitle>

@{
    RadNetSummary? archive = _catalog?.Archive;
    bool ready = !_loading && archive is { Available: true };
}

<section class="wb-workbench" aria-labelledby="wb-title">
    <header class="wb-heading">
        <div>
            <h1 id="wb-title">Data Workbench</h1>
            <p>Organize and review EPA RadNet monitoring records.</p>
        </div>
        @if (_loading || ready)
        {
            <dl class="wb-coverage" aria-label="RadNet archive coverage" aria-busy="@(_loading ? "true" : "false")">
                <div>
                    <dt>Source observations</dt>
                    <dd>@CoverageValue(archive?.ObservationCount)</dd>
                </div>
                <div>
                    <dt>Stations</dt>
                    <dd>@CoverageValue(archive?.StationCount)</dd>
                </div>
                <div>
                    <dt>Annual files</dt>
                    <dd>@CoverageValue(archive?.SourceFileCount)</dd>
                </div>
            </dl>
        }
    </header>

    <nav class="wb-nav" aria-label="Data workbench">
        <a href="workbench" aria-current="@(!ShowProjects && !ShowBuilder && !ShowImportReview ? "page" : null)">
            <RadzenIcon Icon="table_rows" aria-hidden="true" /> Series
        </a>
        <a href="workbench?view=projects" aria-current="@(ShowProjects ? "page" : null)">
            <RadzenIcon Icon="folder_open" aria-hidden="true" /> Projects
        </a>
        <a href="workbench?view=builder" aria-current="@(ShowBuilder ? "page" : null)">
            <RadzenIcon Icon="tune" aria-hidden="true" /> Query Builder
        </a>
        <a href="workbench?view=import" aria-current="@(ShowImportReview ? "page" : null)">
            <RadzenIcon Icon="upload_file" aria-hidden="true" /> Import Review
        </a>
    </nav>

    @if (!_loading && !ready)
    {
        <div class="wb-message" role="alert">
            <h2>Workbench unavailable</h2>
            <p>@(_error ?? "This host is missing the EPA RadNet archive snapshot.")</p>
            <button type="button" @onclick="LoadCatalogAsync">Retry</button>
        </div>
    }
    else if (ShowProjects)
    {
        <WorkbenchProjects Ready="ready" />
    }
    else if (ShowBuilder)
    {
        <WorkbenchQueryBuilder Ready="ready" RunExampleOnLoad="@RunBuilderExample" />
    }
    else if (ShowImportReview)
    {
        <ImportReview Ready="ready" ObservationCount="@(archive?.ObservationCount ?? 0)" />
    }
    else
    {
        <WorkbenchSeriesGrid Ready="ready" Stations="@(_catalog?.Stations ?? [])" />
    }
</section>

@code {
    RenderFragment CoverageValue(long? count) => @<text>
        @if (count is long value)
        {
            @Count(value)
        }
        else
        {
            <span class="wb-coverage-placeholder" aria-hidden="true"></span>
        }
    </text>;
}
