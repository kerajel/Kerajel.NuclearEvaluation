@if (_verified)
{
    @ChildContent
}
else if (_checking)
{
    <div class="captcha-frame" role="status" aria-label="Checking browser verification">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </div>
}
else
{
    <div class="captcha-frame">
        <main class="captcha-panel" aria-labelledby="captcha-title">
            <img src="favicon-192x192.png" width="60" height="60" alt="" />
            <h1 id="captcha-title">Quick human check</h1>
            <p>Your browser solves a short puzzle before you can access the site.</p>

            <div class="captcha-consent">
                <RadzenCheckBox @bind-Value="_cookiesAccepted" Name="cookieConsent" TValue="bool" Change="@(_ => _error = null)" />
                <RadzenLabel Component="cookieConsent">
                    Use a cookie to remember this browser’s verification.
                    I accept.
                </RadzenLabel>
            </div>

            @if (_error is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="false" Variant="Variant.Flat" Shade="Shade.Lighter">
                    @_error
                </RadzenAlert>
            }

            <RadzenButton Text="Accept & verify I'm human"
                          IsBusy="@_solving" BusyText="Verifying..."
                          Icon="verified_user"
                          aria-busy="@(_solving ? "true" : "false")"
                          Disabled="@(_solving || !_cookiesAccepted)"
                          Click="@Solve"
                          Style="width:100%;" />
            @if (_solving)
            {
                <p class="captcha-progress" role="status">Verifying your browser and saving your verification…</p>
            }
        </main>
    </div>
}
