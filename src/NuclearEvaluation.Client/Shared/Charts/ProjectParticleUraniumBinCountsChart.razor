@if (_hasError)
{
    <p role="alert">The chart could not be loaded.</p>
    <RadzenButton Text="Retry chart" Click="Refresh" />
}

@if (_isReady && !string.IsNullOrWhiteSpace(Caption))
{
    <div class="ne-chart-caption">@Caption</div>
}

@if (_isReady)
{
    <RadzenChart>
        <RadzenChartTooltipOptions Shared="@true" />
        <RadzenLineSeries Smooth="@false" Data="@(_particleUraniumBinCounts[nameof(ParticleBase.U234)])" CategoryProperty="Name" Title="@nameof(ParticleBase.U234)" LineType="LineType.Dashed" ValueProperty="Count">
            <RadzenMarkers Visible="@true" MarkerType="MarkerType.Square" />
            <RadzenSeriesDataLabels Visible="@true" />
        </RadzenLineSeries>
        <RadzenLineSeries Smooth="@false" Data="@(_particleUraniumBinCounts[nameof(ParticleBase.U235)])" CategoryProperty="Name" Title="@nameof(ParticleBase.U235)" LineType="LineType.Dashed" ValueProperty="Count">
            <RadzenMarkers Visible="@true" MarkerType="MarkerType.Square" />
            <RadzenSeriesDataLabels Visible="@true" />
        </RadzenLineSeries>
    </RadzenChart>
}
