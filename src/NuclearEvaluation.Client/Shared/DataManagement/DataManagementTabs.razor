<RadzenTabs @bind-SelectedIndex=@_currentTabIndex Change="OnTabChanged" RenderMode="TabRenderMode.Client" Overflow="TabsOverflow.Wrap">
    <Tabs>
        <RadzenTabsItem Text="Series">
            <div class="rz-mb-3">
                <SeriesCountsGrid @ref="_seriesCountsGrid" />
            </div>
            <SeriesGrid @ref="_seriesGrid"
                        ComponentId="27ECF3B0-2BA4-40D0-BF22-EEB4CFE9A2C2"
                        Caption="Filters in this grid also refresh the totals above."
                        OnSeriesSetChanged="OnSeriesSetChange"
                        AllowEdit="true" />
        </RadzenTabsItem>

        <RadzenTabsItem Text="STEM Preview">
            <StemPreview @ref="_stemPreview" StartInQuality="@_startInStemQuality"
                         OnAssistantContextChanged="UpdateAssistantContext" />
        </RadzenTabsItem>

    </Tabs>
</RadzenTabs>
