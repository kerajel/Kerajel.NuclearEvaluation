<CascadingValue Value="GetActivePresetFilter">
    <section class="query-builder-editor" aria-labelledby="query-builder-filter-title">
        <header>
            <h2 id="query-builder-filter-title">Preset Filters</h2>
            <p>Enable the record types you want to filter, then choose which records to return.</p>
        </header>
        <details class="query-builder-examples">
            <summary>Example queries</summary>
            <p>Each example replaces the current draft and refreshes its results.</p>
            <div class="query-builder-examples__options">
                @foreach (QueryBuilderExample example in Examples)
                {
                    <button type="button" @onclick="() => LoadExampleAsync(example)">@example.Title</button>
                }
            </div>
        </details>
        @if (_activeFilter.Id == 0 && !string.IsNullOrWhiteSpace(_activeFilter.Name))
        {
            <p class="ne-grid-caption" role="status"><strong>@_activeFilter.Name</strong> · Unsaved draft</p>
        }
        <div class="query-builder-entities" @oninput="NotifyDraftEdited">
            <div class="query-builder-entity @(GetFilterCheckBoxVisibility(PresetFilterEntryType.Series) ? "is-enabled" : "")">
                <div class="query-builder-entity__heading">
                    <RadzenCheckBox ValueChanged="@(value => OnPresetFilterCheckBoxChanged(value, PresetFilterEntryType.Series))"
                                    Value="@GetFilterCheckBoxVisibility(PresetFilterEntryType.Series)"
                                    TValue="bool"
                                    AriaLabel="Series filter" />
                    <h3>Series</h3>
                </div>
                <SeriesQueryBuilderFilter Visible="GetFilterCheckBoxVisibility(PresetFilterEntryType.Series)"
                                         OnDraftEdited="NotifyDraftEdited"
                                         @ref="_seriesFilter" />
            </div>

            <div class="query-builder-entity @(GetFilterCheckBoxVisibility(PresetFilterEntryType.Sample) ? "is-enabled" : "")">
                <div class="query-builder-entity__heading">
                    <RadzenCheckBox ValueChanged="@(value => OnPresetFilterCheckBoxChanged(value, PresetFilterEntryType.Sample))"
                                    Value="@GetFilterCheckBoxVisibility(PresetFilterEntryType.Sample)"
                                    TValue="bool"
                                    AriaLabel="Sample filter" />
                    <h3>Sample</h3>
                </div>
                <SampleQueryBuilderFilter Visible="GetFilterCheckBoxVisibility(PresetFilterEntryType.Sample)"
                                         OnDraftEdited="NotifyDraftEdited"
                                         @ref="_sampleFilter" />
            </div>

            <div class="query-builder-entity @(GetFilterCheckBoxVisibility(PresetFilterEntryType.SubSample) ? "is-enabled" : "")">
                <div class="query-builder-entity__heading">
                    <RadzenCheckBox ValueChanged="@(value => OnPresetFilterCheckBoxChanged(value, PresetFilterEntryType.SubSample))"
                                    Value="@GetFilterCheckBoxVisibility(PresetFilterEntryType.SubSample)"
                                    TValue="bool"
                                    AriaLabel="SubSample filter" />
                    <h3>SubSample</h3>
                </div>
                <SubSampleQueryBuilderFilter Visible="GetFilterCheckBoxVisibility(PresetFilterEntryType.SubSample)"
                                         OnDraftEdited="NotifyDraftEdited"
                                         @ref="_subSampleFilter" />
            </div>

            <div class="query-builder-entity @(GetFilterCheckBoxVisibility(PresetFilterEntryType.Apm) ? "is-enabled" : "")">
                <div class="query-builder-entity__heading">
                    <RadzenCheckBox ValueChanged="@(value => OnPresetFilterCheckBoxChanged(value, PresetFilterEntryType.Apm))"
                                    Value="@GetFilterCheckBoxVisibility(PresetFilterEntryType.Apm)"
                                    TValue="bool"
                                    AriaLabel="Apm filter" />
                    <h3>Apm</h3>
                </div>
                <ApmQueryBuilderFilter Visible="GetFilterCheckBoxVisibility(PresetFilterEntryType.Apm)"
                                         OnDraftEdited="NotifyDraftEdited"
                                         @ref="_apmFilter" />
            </div>

            <div class="query-builder-entity @(GetFilterCheckBoxVisibility(PresetFilterEntryType.Particle) ? "is-enabled" : "")">
                <div class="query-builder-entity__heading">
                    <RadzenCheckBox ValueChanged="@(value => OnPresetFilterCheckBoxChanged(value, PresetFilterEntryType.Particle))"
                                    Value="@GetFilterCheckBoxVisibility(PresetFilterEntryType.Particle)"
                                    TValue="bool"
                                    AriaLabel="Particle filter" />
                    <h3>Particle</h3>
                </div>
                <ParticleQueryBuilderFilter Visible="GetFilterCheckBoxVisibility(PresetFilterEntryType.Particle)"
                                         OnDraftEdited="NotifyDraftEdited"
                                         @ref="_particleFilter" />
            </div>
        </div>
    </section>

    <div class="query-builder-toolbar">
        <div class="query-builder-toolbar__group">
            <span>Results</span>
            <RadzenDropDown Data="@_dataGrids"
                            TextProperty="@nameof(IDataGridComponent.EntityDisplayName)"
                            Value="@_activeGrid"
                            ValueChanged="OnDataGridSelected"
                            TValue="IDataGridComponent"
                            aria-label="Result entity" />
        </div>

        <div class="query-builder-toolbar__group query-builder-toolbar__presets">
            <span>Saved filter</span>
            <PresetFilterDropDown @ref="_presetDropDown" OnPresetFilterSelected="OnPresetFilterSelected"
                                  OnDraftEdited="NotifyDraftEdited" />
        </div>

        <div class="query-builder-toolbar__apply">
            <RadzenButton Text="Apply query"
                          Icon="search"
                          Click="ApplyPresetFilter" />
        </div>
    </div>

    <SeriesGrid @ref="_seriesGrid"
                ComponentId="query-builder-series"
                Visible="GetDataGridVisibility(_seriesGrid)"
                GetPresetFilterBox="GetPresetFilterBox"
                Caption="Series returned by the current query."
                AllowEdit="false" />

    <SampleGrid @ref="_sampleGrid"
                ComponentId="query-builder-samples"
                Visible="GetDataGridVisibility(_sampleGrid)"
                Caption="Samples returned by the current query."
                GetPresetFilterBox="GetPresetFilterBox" />

    <SubSampleGrid @ref="_subSampleGrid"
                   ComponentId="query-builder-subsamples"
                   Visible="GetDataGridVisibility(_subSampleGrid)"
                   Caption="Subsamples returned by the current query."
                   GetPresetFilterBox="GetPresetFilterBox" />

    <ApmGrid @ref="_apmGrid"
             ComponentId="query-builder-apm"
             Visible="GetDataGridVisibility(_apmGrid)"
             Caption="APM measurements returned by the current query."
             GetPresetFilterBox="GetPresetFilterBox" />

    <ParticleGrid @ref="_particleGrid"
                  ComponentId="query-builder-particles"
                  Visible="GetDataGridVisibility(_particleGrid)"
                  Caption="Particle measurements returned by the current query."
                  GetPresetFilterBox="GetPresetFilterBox" />

</CascadingValue>
