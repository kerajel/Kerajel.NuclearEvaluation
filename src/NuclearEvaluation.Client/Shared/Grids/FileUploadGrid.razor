<RadzenDataGrid Data="@Data"
                TItem="UploadedFile"
                Style="width: 100%;"
                AllowAlternatingRows="false"
                ColumnWidth="auto">
    <Columns>
        <RadzenDataGridColumn TItem="UploadedFile" Title="File">
            <Template Context="file">
                <div class="upload-file">
                    <strong>@file.Name</strong>
                    <div class="upload-file__status">
                        <span>@(file.Size < 1024 ? $"{file.Size:N0} B" : $"{file.Size.AsMegabytes():F2} MB")</span>
                        <span aria-hidden="true">·</span>
                        @if (file.Status == FileStatus.Uploaded)
                        {
                            <span>Uploaded</span>
                        }
                        else if (file.Status is FileStatus.Uploading or FileStatus.Deleting)
                        {
                            <span role="status">@(file.Status == FileStatus.Uploading ? "Uploading…" : "Removing…")</span>
                        }
                        else if (file.Status == FileStatus.UploadError)
                        {
                            <span class="upload-file__error">@file.ErrorMessage</span>
                        }
                        else
                        {
                            <span>Not uploaded</span>
                        }
                    </div>
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="UploadedFile"
                              Width="70px"
                              TextAlign="TextAlign.Center"
                              Title="Remove">
            <Template Context="file">
                <RadzenButton Icon="delete" Size="ButtonSize.Small" Variant="Variant.Text"
                              aria-label="@($"Remove {file.Name}")"
                              title="@($"Remove {file.Name}")"
                              Click="@(() => RemoveFile(file))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
