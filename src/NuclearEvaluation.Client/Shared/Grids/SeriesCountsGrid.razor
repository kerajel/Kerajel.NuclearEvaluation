<section class="ne-series-counts-grid series-totals" aria-labelledby="series-totals-title"
         aria-busy="@(_isLoading ? "true" : "false")">
    <header>
        <h2 id="series-totals-title">Matching records</h2>
        @if (_isLoading)
        {
            <span role="status">Updating totals…</span>
        }
    </header>

    @if (_hasError)
    {
        <p role="alert">Totals could not be refreshed. Change a filter or reload the page to retry.</p>
    }

    <dl>
        <div><dt>Series</dt><dd>@FormatTotal(_summary?.SeriesCount)</dd></div>
        <div><dt>Samples</dt><dd>@FormatTotal(_summary?.SampleCount)</dd></div>
        <div><dt>Subsamples</dt><dd>@FormatTotal(_summary?.SubSampleCount)</dd></div>
        <div><dt>APM measurements</dt><dd>@FormatTotal(_summary?.ApmCount)</dd></div>
        <div><dt>Particles</dt><dd>@FormatTotal(_summary?.ParticleCount)</dd></div>
    </dl>
</section>
